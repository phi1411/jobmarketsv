APP_NAME="Job Marketplace Part-time"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://manguonmo.test

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jobmarket
DB_USER=root
DB_PASSWORD=

# JWT Secret Key (Minimum 32 characters for HS256)
SECRET=change_this_to_a_random_32_character_secret_key

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS="GET, POST, PUT, PATCH, DELETE, OPTIONS"
CORS_ALLOWED_HEADERS="Content-Type, Authorization, X-Requested-With"

# Google OAuth 2.0 Configuration (OpenID Connect)
# Note: Use placeholders only; never commit real credentials to version control.
# For local development, use http://localhost[:port]/auth/google/callback.
# For HTTPS local dev (e.g. manguonmo.test with valid cert), use https:// scheme.
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/auth/google/callback

# Gemini Chatbot Configuration (CHAT-P0-01 & CHAT-P0-02)
# Note: Use placeholders only; never commit real credentials to version control.
# Feature is fail-closed: GEMINI_FEATURE_ENABLED=true, GEMINI_API_KEY, and GEMINI_MODEL must all be explicitly set.
# GEMINI_MODEL is mandatory when enabled (e.g. gemini-1.5-flash); no silent fallback is used.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FEATURE_ENABLED=false
GEMINI_COMPANY_ENABLED=false
GEMINI_TIMEOUT_SECONDS=15
CHAT_GUEST_RATE_LIMIT=10
CHAT_AUTH_RATE_LIMIT=30

# Trusted Proxies (Comma-separated reverse proxy IPs, e.g., 127.0.0.1,10.0.0.1).
# Empty by default so forwarded headers are not trusted. When REMOTE_ADDR is in TRUSTED_PROXIES,
# X-Forwarded-For is parsed from right to left, skipping trusted proxies to find the real client IP.
TRUSTED_PROXIES=

# CV/Profile Matching Hash Key (CV-AI-P0-02)
# Secret key used for HMAC-SHA256 hashing of canonical matching data.
# Do not reuse GEMINI_API_KEY or JWT SECRET.
AI_MATCH_HASH_KEY=

# Match-analysis POST throttle (per authenticated student + application)
AI_MATCH_RATE_LIMIT=5
AI_MATCH_RATE_DECAY_SECONDS=60

# Saved-search job alerts
JOB_ALERT_MATCH_THRESHOLD=65

# Gmail/SMTP delivery. For Gmail, use an App Password (not your normal password).
# When these values are blank in development, emails are safely rendered to storage/app/mail-preview.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@jobmarketsv.local
MAIL_FROM_NAME="JobMarketSV"
