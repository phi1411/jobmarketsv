APP_NAME="Job Marketplace (Testing)"
APP_ENV=testing
APP_DEBUG=true
APP_URL=in-process
TEST_BASE_URL=in-process

# Dedicated Test Database (Isolated from Development)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jobmarket_test
DB_USER=root
DB_PASSWORD=

SECRET=test_secret_key_at_least_32_characters_long_123456

# Google OAuth Configuration for Testing (Mocked / Offline)
GOOGLE_OAUTH_CLIENT_ID=test-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=test-client-secret-value
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/auth/google/callback
